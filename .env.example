# Variáveis usadas pela função serverless api/lead.ts (envio de e-mail via Resend).
# Configurar na Vercel: Project Settings > Environment Variables.
# NÃO commitar valores reais — este arquivo é só exemplo.

# Chave da API do Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Pra onde os leads do formulário chegam (caixa de entrada)
LEAD_TO_EMAIL=japa_ti_suporte@outlook.com

# Remetente exibido no e-mail — precisa ser de domínio verificado no Resend
LEAD_FROM_EMAIL=orcamento@hbcomercio.com.br
